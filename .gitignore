# Run directories: inputs, outputs and logs for individual FVS runs.
# Keep the folder, not its contents.
runs/*
!runs/.gitkeep

# Saved project state
project.json
.ufvs-data/
projects/*.ufvs.json
!projects/.gitkeep

# Engine configuration is machine-specific
config/engine.json

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
Rplots.pdf
release/

# Packaged-build outputs. The launcher binary and the bundle icon are compiled
# and generated during a release build; only their sources belong in the tree.
*.exe
*.iconset/
uFVS.app/
tools/windows/*.o

# FVS output artefacts that can land in the working directory
*.out
*.sum
*.trl
*.key.bak
FVSOut.db
FVS_Data.db

# macOS
.DS_Store
